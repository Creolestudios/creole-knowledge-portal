# =============================================================
# ENVIRONMENT VARIABLES — TEMPLATE FILE
# =============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in the real values below (ask your team lead for credentials)
#   3. NEVER commit .env.local to git — it is already in .gitignore
# =============================================================

# -------------------------------------------------------------
# GEMINI AI
# Required for Gemini AI API calls.
# Get your key from: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# -------------------------------------------------------------
# APP URL
# The base URL of this application.
#   - Local dev:  http://localhost:3000
#   - Production: https://your-domain.com
# -------------------------------------------------------------
APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# SUPABASE — Required for authentication & database access
# Get these values from: https://app.supabase.com
#   → Select your project → Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL     : Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anon key (safe for browser)
#   SUPABASE_SERVICE_ROLE_KEY    : Secret service role key (server-side ONLY)
#
# ⚠️  NEVER expose SUPABASE_SERVICE_ROLE_KEY in client-side code.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# -------------------------------------------------------------
# BLOG ROULETTE MODULE
# -------------------------------------------------------------
# TinyMCE editor — get free key (1000 loads/mo) from https://www.tiny.cloud
NEXT_PUBLIC_TINYMCE_API_KEY="no-api-key"

# Google Drive publish pipeline
DRIVE_FOLDER_ID="your-drive-folder-id"
DRIVE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account",...}'

# Marketing recipients (comma-separated). Drive auto-notifies on file share.
MARKETING_NOTIFY_EMAILS="marketing@creole.com,seo@creole.com"
