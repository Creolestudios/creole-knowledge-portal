{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 - <<'PY'\nimport json\nprint(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"UserPromptSubmit\", \"additionalContext\": \"Project instruction: before responding to this user prompt, inspect the wiki folder when relevant and update the appropriate wiki/log entry with any new logic, task progress, validation results, or decisions made during the response. If no code/task/documentation change is made, explicitly skip wiki updates.\"}}))\nPY",
            "timeout": 5,
            "statusMessage": "Checking wiki update requirement..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /var/www/html/creole-knowledge-portal/.claude/hooks/pre-bash.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /var/www/html/creole-knowledge-portal/.claude/hooks/pre-write.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /var/www/html/creole-knowledge-portal/.claude/hooks/post-write.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /var/www/html/creole-knowledge-portal/.claude/hooks/on-stop.sh"
          }
        ]
      }
    ]
  }
}
