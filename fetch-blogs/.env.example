# ── App ───────────────────────────────────────────────────────────────────────
APP_PROJECT_NAME="Creole Knowledge Portal API"
APP_API_V1_STR=/api/v1
APP_ENVIRONMENT=local          # local | staging | production
APP_CORS_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=DEBUG
# leave blank for local
APP_SENTRY_DSN=

# ── MongoDB ───────────────────────────────────────────────────────────────────
# localhost works because docker compose exposes these ports to your machine.
# In production Docker, compose overrides these to mongo/redis automatically.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=knowledge_portal

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0        # Celery broker
REDIS_RESULT_URL=redis://localhost:6379/1 # Celery results (separate Redis DB)

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=change-me-to-a-32-char-random-string
AUTH_JWT_ALG=HS256
AUTH_JWT_EXP_MINUTES=60

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_GEMINI_API_KEY="your_gemini_api_key_here"
LLM_GEMINI_MODEL=gemini-3.6-flash
LLM_GEMINI_EMBED_MODEL=models/text-embedding-004

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPING_CONCURRENCY=8
SCRAPING_CONTENT_FRESHNESS_DAYS=30
SCRAPING_DIGEST_WORD_TARGET=4500
SCRAPING_CRON_SCHEDULE="30 0 * * *"    # 06:00 IST = 00:30 UTC
SCRAPING_ROBOTS_CACHE_TTL_SECONDS=3600

# Local: run Celery tasks inside FastAPI so Generate works without a worker.
# Set false when you start `celery -A src.workers.celery_app worker ...`
APP_CELERY_EAGER=true

# ── Supabase (copy from repo root .env.local if needed) ───────────────────────
# Root file uses NEXT_PUBLIC_SUPABASE_* — this service also accepts those names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
