# ── App ───────────────────────────────────────────────────────────────────────
APP_PROJECT_NAME="Creole Knowledge Portal API"
APP_API_V1_STR=/api/v1
APP_ENVIRONMENT=local          # local | staging | production
APP_LOG_LEVEL=DEBUG
APP_SENTRY_DSN=                # leave blank for local

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=knowledge_portal

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0        # Celery broker
REDIS_RESULT_URL=redis://redis:6379/1 # Celery result backend (separate DB index)

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=change-me-to-a-32-char-random-string
AUTH_JWT_ALG=HS256
AUTH_JWT_EXP_MINUTES=60

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_GEMINI_API_KEY=your-gemini-api-key
LLM_GEMINI_MODEL=gemini-2.0-flash
LLM_GEMINI_EMBED_MODEL=models/text-embedding-004

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPING_CONCURRENCY=8
SCRAPING_CONTENT_FRESHNESS_DAYS=30
SCRAPING_DIGEST_WORD_TARGET=4500
SCRAPING_CRON_SCHEDULE="30 0 * * *"    # 06:00 IST = 00:30 UTC
SCRAPING_ROBOTS_CACHE_TTL_SECONDS=3600
