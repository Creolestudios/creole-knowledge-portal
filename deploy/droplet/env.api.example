# Template for /opt/ckp/.env.api  (FastAPI + Celery worker + beat containers)
#
#   install -m 600 /dev/null /opt/ckp/.env.api
#   nano /opt/ckp/.env.api
#
# Same rules as .env.production: no quotes, no multi-line values, chmod 600.
#
# Settings use the APP_ prefix (pydantic-settings), so cfg.SECRET_KEY is read
# from APP_SECRET_KEY. If a 401 comes back from an authenticated endpoint, the
# alias is different — check fetch-blogs/src/core/config.py.

APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO
APP_PROJECT_NAME=Creole Knowledge Portal API
APP_API_V1_STR=/api/v1
APP_SENTRY_DSN=

# ── Shared internal token ────────────────────────────────────────────────────
# src/api/deps.py compares the X-Internal-Token header against cfg.SECRET_KEY,
# which lives in AuthSettings (src/core/config.py:104) with env_prefix "AUTH_"
# — so the variable is AUTH_SECRET_KEY, not APP_SECRET_KEY.
# MUST equal BLOG_INTERNAL_TOKEN in .env.production. Both sides default to
# "change-me-to-a-32-char-secret", so they match insecurely if left unset.
#   openssl rand -hex 32
AUTH_SECRET_KEY=

# Optional: only the Mongo-backed routes are used by the portal, but these
# have dummy defaults that would fail loudly if a Supabase-touching route runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── MongoDB Atlas (remote; no mongo container on this droplet) ──────────────
# The 877 MB mongo:7 image is deliberately not used here. Percent-encode any
# special characters in the password (@ becomes %40).
MONGO_URI=
MONGO_DB_NAME=knowledge_portal

# ── Redis (the compose service name, not localhost) ─────────────────────────
# Containers resolve each other by service name on the compose network.
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1

# ── Gemini (synthesis + 768-dim embeddings) ─────────────────────────────────
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_EMBED_MODEL=models/gemini-embedding-001

# ── Scraping pipeline ───────────────────────────────────────────────────────
# Concurrency reduced from the dev default of 8: this box has ~150 Mi of
# headroom and rank_queue loads scikit-learn/numpy per child process.
SCRAPING_CONCURRENCY=4
SCRAPING_CONTENT_FRESHNESS_DAYS=30
SCRAPING_DIGEST_WORD_TARGET=3200
# 00:30 UTC = 06:00 IST. Only takes effect if the `beat` container runs
# (docker compose --profile blog --profile scheduler up -d).
SCRAPING_CRON_SCHEDULE=30 0 * * *
SCRAPING_ROBOTS_CACHE_TTL_SECONDS=3600

# Keep false: true would run heavy pipeline tasks inline in the API process.
APP_CELERY_EAGER=false
