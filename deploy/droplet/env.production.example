# Template for /opt/ckp/.env.production  (Next.js web container)
#
#   install -m 600 /dev/null /opt/ckp/.env.production
#   nano /opt/ckp/.env.production      # paste, fill in real values
#
# RULES (Docker env_file is not a shell):
#   - NO quotes around values. Docker keeps them as literal characters.
#   - NO multi-line values. The Drive JSON must be compacted to one line.
#   - NO spaces around '='.
#   - chmod 600. Never commit the real file.
#
# NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY also appear here for the server runtime,
# but the values the BROWSER uses are baked in at build time by the GitHub
# Actions workflow. Changing them here alone does not change the client bundle.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Empty basePath => app is served at /. Must match the build arg used in CI.
NEXT_PUBLIC_BASE_PATH=

# Public URL testers hit. Update (and restart) when a real domain replaces the IP.
# Read server-side only, so a change needs no rebuild.
APP_URL=https://143.110.245.16
NEXT_PUBLIC_APP_URL=https://143.110.245.16

# ── Supabase: auth, PostgreSQL, storage, realtime ────────────────────────────
# Add APP_URL to Supabase > Authentication > URL Configuration (Site URL +
# Redirect URLs as https://<host>/**) or login silently redirects to localhost.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row level security. Server-side only. Rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Architecture doc says gemini-2.5-flash; the dev env file said gemini-3.6-flash.
# A wrong model name is a hard API error — confirm which is live.
GEMINI_MODEL=gemini-2.5-flash

# ── Google Drive (interview recordings + blog publish) ───────────────────────
# getRecordingFolderId() falls back to DRIVE_FOLDER_ID, so this one is enough.
DRIVE_FOLDER_ID=
# getDriveCredentials() reads DRIVE_SERVICE_ACCOUNT_KEY_JSON first.
# MUST be single-line. Produce it with:
#   jq -c . sa.json > sa.min.json
#   printf 'DRIVE_SERVICE_ACCOUNT_KEY_JSON=%s\n' "$(cat sa.min.json)" >> .env.production
DRIVE_SERVICE_ACCOUNT_KEY_JSON=

# ── Cron endpoints ───────────────────────────────────────────────────────────
# /api/cron/cleanup-recordings and /api/cron/cleanup-storage DELETE data and
# fall back to a hardcoded literal if this is unset. Always set it:
#   openssl rand -hex 24
CRON_SECRET=

# ── Blog module (Stage 2 only; omit while running web alone) ────────────────
# Must match APP_SECRET_KEY in .env.api — the API validates X-Internal-Token
# against it, and both sides default to the same insecure placeholder.
BLOG_SERVICE_URL=http://127.0.0.1:8000/api/v1
BLOG_INTERNAL_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_TINYMCE_API_KEY is a build-time value; setting it here has no
# effect on the browser bundle. Add it as a CI build arg if the editor needs it.
#MARKETING_NOTIFY_EMAILS=
